# Canonical site URL (used for canonical links, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.co.uk

# Enquiry form delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separate for several)
ENQUIRY_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "London Construction & Development <enquiries@example.co.uk>"
ENQUIRY_FROM_EMAIL=
